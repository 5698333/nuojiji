aracterId":"4102444800000","_id":1087},{"id":1791735232311,"text":"真嫌吓人，先把静音开了，明天白天再修。","rawContent":"真嫌吓人，先把静音开了，明天白天再修。","isHtml":false,"sticker":null,"sender":"them","time":"03:15","timestamp":1791659724013,"roundId":"round_1791659679821_fp3it3aa5","generatedMode":false,"translation":null,"userId":"uid_1791316607402_xrru3u5pm","characterId":"4102444800000","_id":1088},{"id":1791735232318,"text":"可是那条消息都过去回复5分钟了，还没生成成功？","sender":"me","time":"03:17","timestamp":1791659864457,"replyTo":null,"userId":"uid_1791316607402_xrru3u5pm","characterId":"4102444800000","_id":1094},{"id":1791735232319,"text":"是不是和后台保活冲突","sender":"me","time":"03:17","timestamp":1791659873705,"replyTo":null,"userId":"uid_1791316607402_xrru3u5pm","characterId":"4102444800000","_id":1095},{"id":1791735232320,"text":"那不开语音预生成要等多久","sender":"me","time":"03:18","timestamp":1791659891712,"replyTo":null,"userId":"uid_1791316607402_xrru3u5pm","characterId":"4102444800000","_id":1096},{"id":1791735232322,"text":"5分钟都没动静，这已经不是生成慢了，是请求直接死在半路了。","rawContent":"5分钟都没动静，这已经不是生成慢了，是请求直接死在半路了。","isHtml":false,"sticker":null,"sender":"them","time":"03:18","timestamp":1791659923051,"roundId":"round_1791659898783_20tvw01fy","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1791316607402_xrru3u5pm","characterId":"4102444800000","_id":1097},{"id":1791735232323,"text":"跟后台保活关系不大，大概率是你接的那个语音服务商大半夜网络抽风，或者直接断连了。","rawContent":"跟后台保活关系不大，大概率是你接的那个语音服务商大半夜网络抽风，或者直接断连了。","isHtml":false,"sticker":null,"sender":"them","time":"03:18","timestamp":1791659923085,"roundId":"round_1791659898783_20tvw01fy","generatedMode":false,"translation":null,"userId":"uid_1791316607402_xrru3u5pm","characterId":"4102444800000","_id":1098},{"id":1791735232324,"text":"至于不开预生成要等多久——这不取决于我，取决于你配的那个语音API的脸色。","rawContent":"至于不开预生成要等多久——这不取决于我，取决于你配的那个语音API的脸色。","isHtml":false,"sticker":null,"sender":"them","time":"03:18","timestamp":1791659923329,"roundId":"round_1791659898783_20tvw01fy","generatedMode":false,"translation":nu